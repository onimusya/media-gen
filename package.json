{
  "name": "media-gen-cli",
  "version": "1.7.0",
  "description": "Production-ready CLI for multi-provider media generation (images, video, voice, audio) designed for developers and AI agents",
  "type": "module",
  "main": "./dist/media-gen.mjs",
  "bin": {
    "media-gen": "./dist/media-gen.mjs"
  },
  "files": [
    "dist/media-gen.mjs",
    "skills/",
    "README.md",
    "LICENSE",
    ".env.example"
  ],
  "scripts": {
    "dev": "tsx src/index.ts",
    "build": "node esbuild.config.mjs",
    "test": "vitest run",
    "test:watch": "vitest",
    "lint": "eslint src/ --ext .ts",
    "format": "prettier --write \"src/**/*.ts\"",
    "typecheck": "tsc --noEmit",
    "prepublishOnly": "npm run build"
  },
  "keywords": [
    "ai",
    "media-generation",
    "image-generation",
    "video-generation",
    "text-to-speech",
    "transcription",
    "openai",
    "gemini",
    "elevenlabs",
    "deepgram",
    "cli"
  ],
  "author": "Francis Hor <francishoe@gmail.com>",
  "license": "MIT",
  "engines": {
    "node": ">=18.0.0"
  },
  "dependencies": {
    "commander": "^12.1.0",
    "dotenv": "^16.4.7",
    "edge-tts-universal": "^1.4.0",
    "ora": "^8.1.1",
    "pino": "^9.6.0",
    "pino-pretty": "^13.2.0",
    "zod": "^4.6.7"
  },
  "devDependencies": {
    "@types/node": "^22.20.5",
    "@typescript-eslint/parser": "^8.73.0",
    "esbuild": "^0.28.2",
    "eslint": "^10.15.0",
    "prettier": "^3.10.1",
    "tsx": "^4.23.15",
    "typescript": "^5.7.2",
    "vite": "^8.3.8",
    "vitest": "^5.1.1"
  }
}
